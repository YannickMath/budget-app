{# templates/emails/forgot_password.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Reset your password - Budget App</title>
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
    <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
        <h1 style="color: #4CAF50;">Password Reset</h1>

        <p>Hello <strong>{{ username }}</strong>,</p>

        <p>
            You have requested to reset your password on Budget App.
            To create a new password, click the button below:
        </p>

        <div style="text-align: center; margin: 30px 0;">
            <a href="{{ resetUrl }}"
               style="background-color: #4CAF50;
                      color: white;
                      padding: 12px 30px;
                      text-decoration: none;
                      border-radius: 5px;
                      display: inline-block;
                      font-weight: bold;">
                Reset my password
            </a>
        </div>

        <p style="color: #666; font-size: 14px;">
            <strong>This link is valid until {{ expirationDate|date('m/d/Y at h:i A') }}</strong>
        </p>

        <p style="color: #666; font-size: 14px;">
            If you did not request a password reset, you can safely ignore this email.
            Your current password will remain unchanged.
        </p>

        <hr style="border: none; border-top: 1px solid #ddd; margin: 30px 0;">

        <p style="color: #999; font-size: 12px;">
            If the button doesn't work, copy and paste this link into your browser:<br>
            <a href="{{ resetUrl }}" style="color: #4CAF50; word-break: break-all;">{{ resetUrl }}</a>
        </p>
    </div>
</body>
</html>
